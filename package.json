{
  "name": "@bigfootds/unity-semver-updater",
  "version": "0.0.6",
  "description": "Update Unity PlayerSettings version values from Node.js.",
  "license": "MIT",
  "author": "BigfootDS",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:code": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BigfootDS/unity-semver-updater"
  },
  "keywords": [
    "unity",
    "gamedev",
    "cicd",
    "ci",
    "semver",
    "utility"
  ],
  "bugs": {
    "url": "https://github.com/BigfootDS/unity-semver-updater/issues"
  },
  "homepage": "https://github.com/BigfootDS/unity-semver-updater#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
